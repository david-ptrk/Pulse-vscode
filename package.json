{
  "name": "pulse-vscode",
  "displayName": "Pulse Language",
  "description": "Syntax highlighting and IntelliSense for the Pulse programming language",
  "version": "0.0.1",
  
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pulse",
        "aliases": [
          "Pulse",
          "pulse"
        ],
        "extensions": [
          ".pul"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pulse",
        "scopeName": "source.pulse",
        "path": "./syntaxes/pulse.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Pulse",
      "properties": {
        "pulse.interpreterPath": {
          "type": "string",
          "default": "",
          "description": "Path to pulse.py interpreter (e.g. C:\\Projects\\Pulse\\pulse.py"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/vscode": "^1.118.0",
    "typescript": "^6.0.3"
  }
}
