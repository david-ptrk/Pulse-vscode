{
  "name": "pulse-vscode",
  "displayName": "Pulse Language",
  "description": "Syntax highlighting and IntelliSense for the Pulse programming language",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/david-ptrk/pulse-vscode.git"
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pulse",
        "aliases": [
          "Pulse",
          "pulse"
        ],
        "extensions": [
          ".pul"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pulse",
        "scopeName": "source.pulse",
        "path": "./syntaxes/pulse.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Pulse",
      "properties": {
        "pulse.interpreterPath": {
          "type": "string",
          "default": "",
          "description": "Path to pulse.py interpreter (e.g. C:\\Projects\\Pulse\\pulse.py"
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:pulse"
  ],
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/vscode": "^1.118.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
