{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Pulse",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#fstrings" },
		{ "include": "#strings" },
		{ "include": "#keywords" },
		{ "include": "#constants" },
		{ "include": "#numbers" },
		{ "include": "#operators" },
		{ "include": "#function-definition" },
		{ "include": "#class-definition" }
	],
	"repository": {
		"comments" : {
			"name": "comment.line.number-sign.pulse",
			"match": "#.*$"
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.pulse",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{ "name": "constant.character.escape.pulse", "match": "\\\\." }
					]
				},
				{
					"name": "string.quoted.single.pulse",
					"begin": "'",
					"end": "'",
					"patterns": [
						{ "name": "constant.character.escape.pulse", "match": "\\\\." }
					]
				}
			]
		},
		"fstrings": {
			"patterns": [
				{
					"name": "string.interpolated.pulse",
					"begin": "f\"",
					"end": "\"",
					"patterns": [
						{
							"name": "meta.embedded.expression.pulse",
							"begin": "\\{",
							"end": "\\}",
							"patterns": [{ "include": "$self" }]
						},
						{ "name": "constant.character.escape.pulse", "match": "\\\\." }
					]
				},
				{
					"name": "string.interpolated.pulse",
					"begin": "f'",
					"end": "'",
					"patterns": [
						{
							"name": "meta.embedded.expression.pulse",
							"begin": "\\{",
							"end": "\\}",
							"patterns": [{ "include": "$self" }]
						},
						{ "name": "constant.character.escape.pulse", "match": "\\\\." }
					]
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.pulse",
					"match": "\\b(if|elif|else|while|for|break|continue|pass|return|match|case)\\b"
				},
				{
					"name": "keyword.control.exception.pulse",
					"match": "\\b(try|except|finally|raise)\\b"
				},
				{
					"name": "keyword.other.pulse",
					"match": "\\b(import|from|as|del|in|is)\\b"
				},
				{
					"name": "storage.type.function.pulse",
					"match": "\\bdef\\b"
				},
				{
					"name": "storage.type.class.pulse",
					"match": "\\bclass\\b"
				},
				{
					"name": "storage.modifier.pulse",
					"match": "\\bstatic\\b"
				},
				{
					"name": "variable.language.self.pulse",
					"match": "\\bself\\b"
				},
				{
					"name": "keyword.operator.word.pulse",
					"match": "\\b(and|or|not)\\b"
				},
				{
					"name": "keyword.other.pulse",
					"match": "\\b(lambda|dot|transpose)\\b"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.boolean.pulse",
					"match": "\\b(True|False)\\b"
				},
				{
					"name": "constant.language.null.pulse",
					"match": "\\b(null|None|NaN)\\b"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.float.pulse",
					"match": "\\b\\d+\\.\\d*([eE][+-]?\\d+)?\\b"
				},
				{
					"name": "constant.numeric.integer.pulse",
					"match": "\\b\\d+\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.assignment.augmented.pulse",
					"match": "(\\+=|-=|\\*=|/=|%=)"
				},
				{
					"name": "keyword.operator.comparison.pulse",
					"match": "(==|!=|<=|>=|<|>)"
				},
				{
					"name": "keyword.operator.assignment.pulse",
					"match": "(?<![=!<>])=(?!=)"
				},
				{
					"name": "keyword.operator.arithmetic.pulse",
					"match": "(\\*\\*|//|[+\\-*/%])"
				},
				{
					"name": "keyword.operator.pipe.pulse",
					"match": "\\|>"
				},
				{
					"name": "keyword.operator.matrix.pulse",
					"match": "@"
				}
			]
		},
		"function-definition": {
            "match": "\\b(def)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
            "captures": {
                "1": { "name": "storage.type.function.pulse" },
                "2": { "name": "entity.name.function.pulse" }
            }
        },
		"class-definition": {
			"match": "\\b(class)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
			"captures": {
				"1": { "name": "storage.type.class.pulse" },
				"2": { "name": "entity.name.type.class.pulse" }
			}
		}
	},
	"scopeName": "source.pulse"
}